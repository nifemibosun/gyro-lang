extern func gyro_print<T>(t: T);

public func print<T>(t: T) {
    gyro_print(t);
}

public func println<T>(t: T) {
    gyro_print(t);
}

extern func atoi(s: string): int32;
extern func atof(s: string): float64;

public func parse_int(s: string): int32 {
    return atoi(s);
}

public func parse_float(s: string): float64 {
    return atof(s);
}


// Function to find fibonacci of a number

fun fibonacci(n: int): int {
    if (n <= 1) {
        return n;
    }

    return fibonacci(n - 1) + fibonacci(n - 2);
}

fun main(): int {
    let i = 0;

    while (i <= 10) {
        println("fibonacci(10) = " + fibonacci(10));
    }
    
    return 0;
}

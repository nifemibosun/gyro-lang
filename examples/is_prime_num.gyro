// Function to check if a number is prime

fun isPrime(num: int): bool {
    if (num <= 1) {
        return false;
    }

    if (num == 2) {
        return true;
    }

    if (num % 2 == 0) {
        return false;
    }
    
    let i: int = 3;

    while (i * i <= num) {
        if (num % i == 0) {
            return false;
        }
        i = i + 2;
    }
    
    return true;
}

fun main(): void {
    let testNum: int = 17;
    let isPrimeResult: bool = isPrime(testNum);
    println("Is " + testNum + " prime? " + isPrimeResult);
}
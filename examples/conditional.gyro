fun is_greater(a: int, b: int): int {
    if (a == b) {
        return 0;
    }

    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fun for_loop(n: int): void {
    let i: int = 0;

    while (i <= 10) {
        println(i);
        i = i + 1;
    }
    
    println("Loop finished.");
}


fun main(): void {
    println(is_greater(5, 4));
    println("\n");
    for_loop(10);
}
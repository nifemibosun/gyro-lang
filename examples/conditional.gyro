fun is_greater(a: int, b: int): int {
    if (a == b) {
        return 0;
    }

    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fun for_loop(n: int): void {
    for (let i = 0; i < n; i = i + 1) {
        println(i);
    }
    println("Loop finished.");
}


fun main(): void {
    println(is_greater(5, 4));
    println("\n");
    for_loop(10);
}
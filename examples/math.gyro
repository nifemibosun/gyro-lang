// Math utilities module
// To cannot be compiled because it includes no main function

fun add(a: int, b: int): int {
    return a + b;
}

fun subtract(a: int, b: int): int {
    return a - b;
}

fun multiply(a: int, b: int): int {
    return a * b;
}

fun divide(a: int, b: int): int {
    if (b == 0) {
        return 0;
    }
    return a / b;
}

fun power(base: int, exp: int): int {
    let result: int = 1;
    for (let i: int = 0; i < exp; i = i + 1) {
        result = result * base;
    }
    return result;
}

fun square(n: int): int {
    return n * n;
}

fun cube(n: int): int {
    return n * n * n;
}

fun abs(n: int): int {
    if (n < 0) {
        return n * -1;
    }
    return n;
}
